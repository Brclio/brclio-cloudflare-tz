{
  "name": "brclio-cloudflare-tz",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "description": "Brclio Edge — an open source Cloudflare tunnel console based on cmliu/edgetunnel",
  "license": "GPL-2.0-only",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:tutorial": "node scripts/build-tutorial.mjs",
    "dev": "npm run build && wrangler dev --local --port 8787",
    "check": "node scripts/check.mjs",
    "pretest": "npm run build",
    "test": "node --test tests/*.test.mjs",
    "deploy": "npm run build && wrangler deploy",
    "deploy:pages": "npm run build && wrangler pages deploy dist/pages"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "miniflare": "5.20260911.1-alpha",
    "qrcode-generator": "2.0.4",
    "wrangler": "4.131.2"
  }
}
